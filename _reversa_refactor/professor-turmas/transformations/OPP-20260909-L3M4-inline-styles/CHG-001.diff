diff --git a/src/styles/main.css b/src/styles/main.css
index 1b330d0..f9c3a5b 100644
--- a/src/styles/main.css
+++ b/src/styles/main.css
@@ -2236,4 +2236,339 @@ html.dark .auth-brand-side {
   .form-header-split p {
     display: none; /* Oculta títulos duplicados no desktop */
   }
+}
+
+/* =====================================================
+   PROFESSOR TURMAS VIEW
+   Estilos escopados da view de notas e frequência
+   ===================================================== */
+
+.professor-turmas-view .pt-header {
+  margin-bottom: 2rem;
+}
+
+.professor-turmas-view .pt-header-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.professor-turmas-view .pt-title-h1 {
+  font-size: 2rem;
+  color: var(--text-main);
+}
+
+.professor-turmas-view .pt-empty-card {
+  background: var(--white);
+  padding: 3rem;
+  text-align: center;
+  border-radius: var(--radius-lg);
+}
+
+.professor-turmas-view .pt-empty-title {
+  color: var(--text-muted);
+  font-size: 1.1rem;
+}
+
+.professor-turmas-view .pt-empty-sub {
+  color: var(--text-muted);
+  font-size: 0.9rem;
+}
+
+.professor-turmas-view .pt-turmas-list {
+  display: flex;
+  flex-direction: column;
+  gap: 1.5rem;
+}
+
+.professor-turmas-view .pt-turma-card {
+  background: var(--white);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow-sm);
+  overflow: hidden;
+}
+
+.professor-turmas-view .pt-turma-summary {
+  padding: 1.5rem;
+  cursor: pointer;
+  background: linear-gradient(135deg, var(--primary) 0%, #2a4a7f 100%);
+  color: var(--white);
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.professor-turmas-view .pt-turma-title {
+  margin: 0;
+  font-size: 1.2rem;
+}
+
+.professor-turmas-view .pt-badges {
+  display: flex;
+  gap: 0.5rem;
+  margin-top: 0.3rem;
+}
+
+.professor-turmas-view .pt-chevron {
+  transition: transform 0.2s;
+}
+
+.professor-turmas-view .pt-card-body {
+  padding: 1.5rem;
+}
+
+.professor-turmas-view .pt-tabs {
+  margin-bottom: 1rem;
+  display: flex;
+  gap: 0.5rem;
+  padding: 0.5rem;
+  background: rgba(0, 0, 0, 0.03);
+  border-radius: 12px;
+  border-bottom: 1px solid var(--secondary);
+  width: 100%;
+  overflow-x: auto;
+  scroll-behavior: smooth;
+  scrollbar-width: none;
+}
+
+.professor-turmas-view .pt-tabs::-webkit-scrollbar {
+  display: none;
+}
+
+.professor-turmas-view .pt-tab-btn {
+  padding: 0.5rem 1rem;
+  border: none;
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+  border-radius: 4px 4px 0 0;
+  font-weight: 600;
+  font-size: 0.9rem;
+  transition: all 0.2s ease;
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+
+.professor-turmas-view .pt-tab-btn.active {
+  background: var(--secondary);
+  color: var(--text-main);
+}
+
+.professor-turmas-view .pt-tab-content {
+  display: none;
+  animation: fadeIn 0.3s ease;
+}
+
+.professor-turmas-view .pt-tab-content.active {
+  display: block;
+}
+
+@media (max-width: 768px) {
+  .professor-turmas-view .pt-tabs {
+    flex-direction: column;
+    gap: 0.5rem;
+  }
+
+  .professor-turmas-view .pt-tab-btn {
+    padding: 0.5rem 1rem;
+    text-align: left;
+  }
+}
+
+.professor-turmas-view .pt-fieldset {
+  border: 1px solid var(--secondary);
+  padding: 1rem;
+  border-radius: 8px;
+  margin-bottom: 1rem;
+}
+
+.professor-turmas-view .pt-legend {
+  font-weight: 600;
+  color: var(--primary);
+  padding: 0 0.5rem;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.professor-turmas-view .pt-pdf-btn {
+  font-size: 0.7rem;
+  padding: 0.2rem 0.5rem;
+}
+
+.professor-turmas-view .pt-table-wrap {
+  overflow-x: auto;
+}
+
+.professor-turmas-view .pt-table {
+  width: 100%;
+  border-collapse: collapse;
+  min-width: 700px;
+}
+
+.professor-turmas-view .pt-thead {
+  background: var(--secondary);
+  font-size: 0.8rem;
+  text-transform: uppercase;
+}
+
+.professor-turmas-view .pt-th-left {
+  padding: 0.75rem;
+  text-align: left;
+}
+
+.professor-turmas-view .pt-th-center {
+  padding: 0.75rem;
+  text-align: center;
+}
+
+.professor-turmas-view .pt-th-center-hl {
+  padding: 0.75rem;
+  text-align: center;
+  background: #f0f4f8;
+}
+
+.professor-turmas-view .pt-row {
+  border-top: 1px solid var(--secondary);
+}
+
+.professor-turmas-view .pt-td {
+  padding: 0.5rem;
+}
+
+.professor-turmas-view .pt-td-center {
+  padding: 0.5rem;
+  text-align: center;
+}
+
+.professor-turmas-view .pt-td-hl {
+  padding: 0.5rem;
+  text-align: center;
+  font-weight: bold;
+  background: #f0f4f8;
+}
+
+.professor-turmas-view .pt-td-empty {
+  padding: 1rem;
+  text-align: center;
+  color: var(--text-muted);
+}
+
+.professor-turmas-view .pt-td-error {
+  padding: 1rem;
+  text-align: center;
+  color: var(--danger);
+}
+
+.professor-turmas-view .pt-status {
+  font-weight: 600;
+  font-size: 0.8rem;
+}
+
+.professor-turmas-view .pt-status-ok {
+  color: var(--success);
+}
+
+.professor-turmas-view .pt-status-fail {
+  color: var(--danger);
+}
+
+.professor-turmas-view .pt-num-input {
+  width: 50px;
+  text-align: center;
+  padding: 0.3rem;
+}
+
+.professor-turmas-view .pt-notes-footer {
+  display: flex;
+  justify-content: space-between;
+  margin-top: 1rem;
+  align-items: center;
+}
+
+.professor-turmas-view .pt-alertas {
+  font-size: 0.85rem;
+}
+
+.professor-turmas-view .pt-alerta-tardia {
+  color: var(--warning-text);
+  background: var(--warning-bg);
+  padding: 0.2rem 0.5rem;
+  border-radius: 4px;
+  font-size: 0.75rem;
+}
+
+.professor-turmas-view .pt-alerta-baixa-titulo {
+  color: var(--danger);
+  font-weight: 600;
+}
+
+.professor-turmas-view .pt-alerta-nome {
+  margin-left: 0.5rem;
+  font-size: 0.8rem;
+}
+
+.professor-turmas-view .pt-alerta-ok {
+  color: var(--success);
+  font-weight: 600;
+}
+
+.professor-turmas-view .pt-freq-box {
+  background: #f8fafc;
+  padding: 1.5rem;
+  border-radius: 8px;
+  margin-bottom: 1rem;
+}
+
+.professor-turmas-view .pt-freq-title {
+  margin-bottom: 0.5rem;
+}
+
+.professor-turmas-view .pt-freq-hint {
+  font-size: 0.85rem;
+  color: var(--text-muted);
+  margin-bottom: 1rem;
+}
+
+.professor-turmas-view .pt-freq-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 1rem;
+  margin-bottom: 1rem;
+}
+
+.professor-turmas-view .pt-freq-list {
+  background: var(--white);
+  padding: 1rem;
+  border-radius: 8px;
+  margin-bottom: 1rem;
+}
+
+.professor-turmas-view .pt-freq-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 0.5rem 0;
+  border-bottom: 1px solid var(--secondary);
+}
+
+.professor-turmas-view .pt-freq-nome {
+  font-weight: 500;
+}
+
+.professor-turmas-view .pt-freq-label {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+  cursor: pointer;
+}
+
+.professor-turmas-view .pt-freq-checkbox {
+  width: 18px;
+  height: 18px;
+}
+
+.professor-turmas-view .pt-freq-ausente {
+  font-size: 0.85rem;
+  color: var(--text-muted);
 }
